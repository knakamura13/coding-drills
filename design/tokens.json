{
  "$description": "Facet Learning design tokens v1, the single source. `pnpm tokens` writes src/lib/ui/tokens.css, src/lib/ui/tokens.ts and design/figcraft-variables.json from this file. Edit values here, never in the generated files.",
  "neutral": {
    "void": "#040405",
    "midnight": "#08080A",
    "night": "#141517",
    "dusk": "#1E1F21",
    "twilight": "#2A2B2E",
    "shade": "#424244",
    "haze": "#68696B",
    "mist": "#A4A4A7",
    "frost": "#D7D7D9",
    "starlight": "#F1F2F4"
  },
  "hue": {
    "teal": "#54DDCE",
    "amber": "#F3B957",
    "blue": "#7BBFFF",
    "lime": "#A4D76C",
    "violet": "#BAABFE",
    "orchid": "#F6A6DF",
    "rose": "#F87584"
  },
  "branch-name": {
    "foundations": "Foundations",
    "sequences-and-search": "Sequences and search",
    "data-structures": "Data structures",
    "trees-and-graphs": "Trees and graphs",
    "problem-solving-patterns": "Problem-solving patterns",
    "role-specific": "Role-specific"
  },
  "branch": {
    "foundations": "teal",
    "sequences-and-search": "amber",
    "data-structures": "blue",
    "trees-and-graphs": "lime",
    "problem-solving-patterns": "violet",
    "role-specific": "orchid"
  },
  "role": {
    "surface-page": "midnight",
    "surface-card": "night",
    "surface-inset": "void",
    "surface-hover": "dusk",
    "border-default": "twilight",
    "border-strong": "shade",
    "text-primary": "starlight",
    "text-secondary": "mist",
    "icon-muted": "haze",
    "action-primary": "starlight",
    "action-primary-pressed": "frost",
    "action-on-primary": "midnight",
    "focus-ring": "accent",
    "status-missed": "rose"
  },
  "accent": {
    "$description": "Values derived from the screen's branch hue. `none` is a screen with no branch. Mix amounts are the share of the hue blended over the named neutral, in sRGB.",
    "none": "starlight",
    "tint": { "over": "night", "amount": 0.12 },
    "border": { "over": "night", "amount": 0.35 },
    "ambient": { "over": "midnight", "amount": 0.04 },
    "glow-alpha": 0.5,
    "soft-glow-alpha": 0.12
  },
  "feedback": {
    "wrong-border": { "hue": "rose", "over": "night", "amount": 0.45 }
  },
  "overlay": {
    "scrim": { "color": "midnight", "alpha": 0.7 },
    "card-edge": { "color": "#FFFFFF", "alpha": 0.08 }
  },
  "font": {
    "sans": "'Geist Variable', 'Geist', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
    "mono": "'Geist Mono Variable', 'Geist Mono', ui-monospace, 'SF Mono', Menlo, monospace"
  },
  "text": {
    "$description": "size / line height in px, weight, tracking in em. `desktop` overrides apply at 1024px and wider.",
    "display": { "size": 30, "line": 36, "weight": 700, "tracking": -0.02, "desktop": { "size": 36, "line": 42 } },
    "title": { "size": 22, "line": 28, "weight": 600, "tracking": -0.01, "desktop": { "size": 26, "line": 32 } },
    "heading": { "size": 18, "line": 24, "weight": 600, "tracking": 0, "desktop": { "size": 20, "line": 28 } },
    "body": { "size": 16, "line": 24, "weight": 400, "tracking": 0 },
    "label": { "size": 14, "line": 20, "weight": 500, "tracking": 0 },
    "caption": { "size": 12, "line": 16, "weight": 400, "tracking": 0 },
    "code": { "size": 14, "line": 22, "weight": 400, "tracking": 0, "family": "mono" },
    "button": { "size": 16, "line": 20, "weight": 600, "tracking": 0 }
  },
  "space": {
    "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "7": 32, "8": 48,
    "screen-edge": 16,
    "card-padding": 16,
    "gap": 12
  },
  "radius": {
    "tag": 4,
    "control": 8,
    "card": 12,
    "sheet": 16,
    "round": 9999
  },
  "motion": {
    "$description": "One curve everywhere. Reduce effects keeps durations but sets shift to 0 (slides become fades), stops loops and ambient effects (fx 0).",
    "ease": "cubic-bezier(0.2, 0, 0, 1)",
    "duration": {
      "state": 150,
      "toast-out": 200,
      "toast-in": 250,
      "morph": 250,
      "sheet": 300,
      "caption": 400,
      "bloom": 900,
      "ripple": 1100,
      "ripple-stagger": 250,
      "toast-hold": 2600,
      "breath": 5000
    },
    "shift": { "full": 1, "reduced": 0 },
    "fx": { "full": 0.5, "reduced": 0 },
    "toast-distance": 16
  }
}
