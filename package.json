{
	"name": "coding-drills",
	"private": true,
	"version": "0.0.1",
	"description": "Quiz drills for coding-interview topics. Every wrong answer triggers a follow-up question that checks why it was wrong.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/knakamura13/coding-drills.git"
	},
	"type": "module",
	"packageManager": "pnpm@12.3.4",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "vite dev --host --port 5173 --strictPort",
		"build": "vite build",
		"preview": "vite preview --strictPort",
		"start": "node build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && pnpm check:railway",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:railway": "tsc --noEmit --ignoreConfig --strict --target es2022 --module nodenext --moduleResolution nodenext --skipLibCheck --erasableSyntaxOnly .railway/railway.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@electric-sql/pglite": "^0.5.8",
		"@electric-sql/pglite-socket": "^0.2.11",
		"@fontsource-variable/nunito": "^5.3.0",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^4.1.11",
		"postgres": "^3.4.9",
		"railway": "3.13.1",
		"svelte": "5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "8.3.4",
		"vitest": "^4.1.11",
		"yaml": "^2.9.1",
		"zod": "^4.6.5"
	}
}
