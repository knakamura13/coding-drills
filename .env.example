# Copy to .env for local development. Never commit .env.
# Without DATABASE_URL the app runs local-only and every /api route answers "unavailable".

# `node e2e/pg-server.mjs` starts a throwaway Postgres engine on this port.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres

# Google OAuth client (Web application). Redirect URI: http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated Google accounts allowed to sign in. Empty allows nobody.
ALLOWED_EMAILS=
